# Copy to .env and fill in. .env is git-ignored.

# Leave empty to use local PGlite (real Postgres, stored in .data/).
# For Neon: Project > Connect > copy the connection string (pooled is fine for the app).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Run migrations (and seed an empty catalog) on server start. Set false to run `npm run db:migrate` yourself.
AUTO_MIGRATE=true

# First admin account. Created on server start if it doesn't exist (an existing password is never overwritten).
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Lumzi Admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
